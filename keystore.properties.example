# Copy this file to "keystore.properties" (same folder) and fill in your own values to build signed
# release APKs locally. keystore.properties is git-ignored: never commit it or the keystore itself.
# On Windows, use forward slashes in the path, e.g. C:/Users/you/keystores/komascroll-release.jks
storeFile=C:/Users/YOUR_NAME/keystores/komascroll-release.jks
storePassword=YOUR_KEYSTORE_PASSWORD
keyAlias=komascroll
keyPassword=YOUR_KEY_PASSWORD
